// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output = "./generated"
}

datasource db {
  provider = "postgresql"
  // For local development
  //url = "postgresql://flow_user:Pass1234@localhost:5432/flownote"
  // For docker
  url = "postgresql://flow_user:Pass1234@flownote_db:5432/flownote"
}

model Sample {
  id   Int    @id @default(autoincrement())
  data String
}

// Define your models here and run `npx prisma generate` to update the Prisma Client
// Then run `npx prisma migrate dev --name name_of_migration` to create a migration and update your database
